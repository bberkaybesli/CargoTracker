@model IEnumerable<KaraAmbarKargoculuk.Models.Kargo>

@{
    ViewData["Title"] = "Kara Ambar"; // Sayfa başlığı
}

<h1>Kargo Listesi</h1> @* Başlık *@

<p>
    <a asp-action="Create">Kargo Oluştur</a> @* Yeni kargo ekleme bağlantısı *@
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TakipKodu) @* Sütun başlığı: Takip Kodu *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gonderici) @* Sütun başlığı: Gönderici *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Alici) @* Sütun başlığı: Alıcı *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Durum) @* Sütun başlığı: Durum *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Konum) @* Sütun başlığı: Konum *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Urun) @* Sütun başlığı: Ürün Bilgisi *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GonderiTarihi) @* Sütun başlığı: Gönderi Tarihi *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TahminiTeslimTarihi) @* Sütun başlığı: Tahmini Teslim Tarihi *@
            </th>
            <th></th> @* İşlemler sütunu (düzenle, detaylar, sil) *@
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TakipKodu) @* Takip Kodu verisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Gonderici) @* Gönderici verisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Alici) @* Alıcı verisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Durum) @* Durum verisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Konum) @* Konum verisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Urun) @* Ürün bilgisi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GonderiTarihi) @* Gönderi tarihi *@
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TahminiTeslimTarihi) @* Tahmini teslim tarihi *@
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Detaylar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Sil</a> @* İşlem bağlantıları *@
                </td>
            </tr>
        }
    </tbody>
</table>
