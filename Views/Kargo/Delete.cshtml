@model KaraAmbarKargoculuk.Models.Kargo

@{
    ViewData["Title"] = "Sil";
}

<h1>Sil</h1>

<h3>Silmek istediğine emin misin?</h3>
<div>
    <h4>Kargo</h4>
    <hr />
    <dl class="row">
        <!-- Takip Kodu başlığı -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TakipKodu) <!-- Modeldeki TakipKodu property'sinin başlığını getirir -->
        </dt>
        <!-- Takip Kodu değeri -->
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TakipKodu) <!-- Modeldeki TakipKodu property'sinin değerini getirir -->
        </dd>

        <!-- Gönderici başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Gonderici)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Gonderici)
        </dd>

        <!-- Alıcı başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Alici)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Alici)
        </dd>

        <!-- Durum başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Durum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Durum)
        </dd>

        <!-- Konum başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Konum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Konum)
        </dd>

        <!-- Ürün başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Urun)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Urun)
        </dd>

        <!-- Gönderi Tarihi başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GonderiTarihi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GonderiTarihi)
        </dd>

        <!-- Tahmini Teslim Tarihi başlığı ve değeri -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TahminiTeslimTarihi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TahminiTeslimTarihi)
        </dd>
    </dl>

    <!-- Kargo silme formu -->
    <form asp-action="Delete">
        <!-- Form, KargoController içindeki [HttpPost] Delete action'a gönderilir -->
        <input type="hidden" asp-for="Id" /> <!-- Silinecek kargonun ID bilgisi gizli olarak gönderilir -->
        <input type="submit" value="Sil" class="btn btn-danger" /> |
        <a asp-action="Index">Listeye geri dön</a> <!-- Kullanıcıyı Kargo listesine geri gönderir -->
    </form>
</div>
