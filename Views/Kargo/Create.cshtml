@model KaraAmbarKargoculuk.Models.Kargo

@{
    ViewData["Title"] = "Kargo Oluştur";
}

<h1>Kargo Oluştur</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="TakipKodu" class="control-label"></label>
                <input asp-for="TakipKodu" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="Gonderici" class="control-label"></label>
                <input asp-for="Gonderici" class="form-control" />
                <span asp-validation-for="Gonderici" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Alici" class="control-label"></label>
                <input asp-for="Alici" class="form-control" />
                <span asp-validation-for="Alici" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Durum" class="control-label"></label>
                <input asp-for="Durum" class="form-control" />
                <span asp-validation-for="Durum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Konum" class="control-label"></label>
                <input asp-for="Konum" class="form-control" />
                <span asp-validation-for="Konum" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Urun" class="control-label"></label>
                <input asp-for="Urun" class="form-control" />
                <span asp-validation-for="Urun" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GonderiTarihi" class="control-label"></label>
                <input asp-for="GonderiTarihi" class="form-control" />
                <span asp-validation-for="GonderiTarihi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TahminiTeslimTarihi" class="control-label"></label>
                <input asp-for="TahminiTeslimTarihi" class="form-control" />
                <span asp-validation-for="TahminiTeslimTarihi" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Oluştur" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Listeye Dön</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
