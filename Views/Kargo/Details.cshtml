@model KaraAmbarKargoculuk.Models.Kargo

@{
    ViewData["Title"] = "Detaylar";
}

<h1>Detaylar</h1>

<div>
    <h4>Kargo</h4>
    <hr />
    <dl class="row">
        <!-- Takip Kodu başlığı -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TakipKodu) <!-- Modeldeki "TakipKodu" alanının adını getirir -->
        </dt>
        <!-- Takip Kodu değeri -->
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TakipKodu) <!-- Modeldeki "TakipKodu" alanının değerini gösterir -->
        </dd>

        <!-- Gönderici -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Gonderici)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Gonderici)
        </dd>

        <!-- Alıcı -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Alici)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Alici)
        </dd>

        <!-- Durum -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Durum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Durum)
        </dd>

        <!-- Konum -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Konum)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Konum)
        </dd>

        <!-- Ürün -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Urun)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Urun)
        </dd>

        <!-- Gönderi Tarihi -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.GonderiTarihi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.GonderiTarihi)
        </dd>

        <!-- Tahmini Teslim Tarihi -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TahminiTeslimTarihi)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TahminiTeslimTarihi)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Düzenle</a> <!-- ID’si verilen kargonun edit sayfasına gider -->
    |
    <a asp-action="Index">Listeye geri dön</a> <!-- Tüm kargoların listelendiği sayfaya döner -->
</div>
