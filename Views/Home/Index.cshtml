<script>
    // Navbar sağ butonu tıklanınca kargo takip formuna yumuşak kaydırma + inputa focus
    document.addEventListener("DOMContentLoaded", function () {
        var takipBtn = document.querySelector('.btn-orange[href="#kargotakip"]');
        var input = document.querySelector('#kargotakip input[name="TakipKodu"]');

        function scrollAndFocus() {
            var hedef = document.getElementById('kargotakip');
            if (hedef) {
                window.scrollTo({
                    top: hedef.getBoundingClientRect().top + window.scrollY - 40,
                    behavior: 'smooth'
                });
                setTimeout(function () {
                    if (input) input.focus();
                }, 450);
            }
        }

        if (takipBtn) {
            takipBtn.addEventListener('click', function (e) {
                e.preventDefault();
                scrollAndFocus();
            });
        }

        // Eğer URL'de #kargotakip ile açılırsa otomatik focusla
        if (window.location.hash === "#kargotakip") {
            setTimeout(function () {
                if (input) input.focus();
            }, 500);
        }
    });
</script>

