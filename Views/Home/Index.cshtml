<style>
    .navbar-custom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
    }

        .navbar-custom .navbar-brand {
            display: flex;
            align-items: center;
            margin-right: 20px;
        }

    .brand-icon {
        font-size: 2.8rem;
        color: #FF6600;
        margin-right: 14px;
        line-height: 1;
    }

    /* Kargo Takibi Butonu için */
    .btn-orange {
        background-color: #FF6600;
        color: #fff;
        border-radius: 32px;
        border: none;
        font-size: 1.3rem;
        font-weight: bold;
        transition: background 0.2s, color 0.2s;
        width: 300px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 32px 0 rgba(255, 102, 0, 0.10);
        white-space: nowrap;
    }

        .btn-orange:hover, .btn-orange:focus {
            background-color: #d35400;
            color: #fff;
            text-decoration: none;
        }

    .navbar-right-cta {
        flex: 0 0 320px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        padding-left: 16px;
    }

    @@media (max-width: 1199.98px) {
        .btn-orange {
            width: 220px;
            height: 52px;
            font-size: 1rem;
        }

        .navbar-right-cta {
            flex: 0 0 220px;
            padding-left: 8px;
        }
    }

    @@media (max-width: 991.98px) {
        .brand-icon {
            font-size: 2rem;
            margin-right: 8px;
        }

        .navbar-right-cta {
            display: none !important;
        }
    }
</style>

