@model KaraAmbarKargoculuk.Models.Kargo

@{
    ViewData["Title"] = "Kargo Takip Sonucu"; // Sayfa başlığı tanımlanıyor

    var durum = Model?.Durum?.ToLower() ?? ""; // Kargonun durumu küçük harfe çevrilerek işleniyor

    string renk = "secondary"; // Varsayılan renk
    string ikon = "fas fa-box"; // Varsayılan ikon

    // Duruma göre renk ve ikon değiştiriliyor
    if (durum.Contains("yolda")) { renk = "info"; ikon = "fas fa-truck-moving"; }
    else if (durum.Contains("şube")) { renk = "warning"; ikon = "fas fa-warehouse"; }
    else if (durum.Contains("teslim")) { renk = "success"; ikon = "fas fa-check-circle"; }
    else if (durum.Contains("hazırlanıyor")) { renk = "primary"; ikon = "fas fa-cogs"; }
    else if (durum.Contains("iptal")) { renk = "danger"; ikon = "fas fa-times-circle"; }
}

@if (Model == null)
{
    // Eğer model boşsa yani kargo bulunamadıysa kullanıcıya hata mesajı göster
    <div class="alert alert-danger mt-4 shadow-sm rounded">
        <i class="fas fa-times-circle"></i> Kargo bulunamadı. Lütfen takip kodunu kontrol edin.
    </div>
}
else
{
    // Kargo bilgileri detaylı şekilde gösteriliyor
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-10">
            <div class="card shadow-lg border-0 my-5">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-@renk d-flex align-items-center justify-content-center mr-3" style="width:56px;height:56px;">
                            <i class="@ikon text-white" style="font-size:2rem;"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 font-weight-bold">@Model.TakipKodu</h4>
                            <span class="badge badge-@renk px-3 py-2 mt-2" style="font-size:1rem;">
                                <i class="@ikon mr-1"></i> @Model.Durum
                            </span>
                        </div>
                    </div>

                    <hr />

                    @* Kargo bilgileri kutuları *@
                    <div class="row mb-3">
                        <div class="col-6 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-user mr-1"></i> Gönderici:</span>
                            <div class="info-box">@Model.Gonderici</div>
                        </div>
                        <div class="col-6 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-user-check mr-1"></i> Alıcı:</span>
                            <div class="info-box">@Model.Alici</div>
                        </div>
                        <div class="col-6 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-calendar-alt mr-1"></i> Gönderi Tarihi:</span>
                            <div class="info-box">@Model.GonderiTarihi.ToShortDateString()</div>
                        </div>
                        <div class="col-6 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-calendar-check mr-1"></i> Tahmini Teslim:</span>
                            <div class="info-box">@(Model.TahminiTeslimTarihi?.ToShortDateString() ?? "-")</div>
                        </div>
                        <div class="col-6 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-map-marker-alt mr-1"></i> Son Konum:</span>
                            <div class="info-box">@Model.Konum</div>
                        </div>
                        <div class="col-12 mb-2">
                            <span class="font-weight-bold text-dark"><i class="fas fa-info-circle mr-1"></i> Ürün Bilgisi:</span>
                            <div class="info-box">@Model.Urun</div>
                        </div>
                    </div>

                    <hr />

                    @* Navigasyon butonları *@
                    <div class="d-flex justify-content-between">
                        <a href="/" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="fas fa-arrow-left mr-1"></i> Anasayfa
                        </a>
                        <a href="/#kargotakip" class="btn btn-orange rounded-pill px-4" id="yeniKargoBtn">
                            <i class="fas fa-search mr-1"></i> Yeni Kargo Sorgula
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script>
    // Sayfa yüklendiğinde "Yeni Kargo Sorgula" butonuna tıklanınca işlemleri yap
    document.addEventListener("DOMContentLoaded", function () {
        var yeniBtn = document.getElementById("yeniKargoBtn");

        if (yeniBtn) {
            yeniBtn.addEventListener("click", function (e) {
                e.preventDefault();

                // Eğer kullanıcı anasayfadaysa yumuşak kaydırma yap
                if (window.location.pathname === "/" || window.location.pathname === "/Home/Index") {
                    var hedef = document.getElementById("kargotakip");
                    var input = hedef ? hedef.querySelector('input[name="TakipKodu"]') : null;

                    if (hedef) {
                        window.scrollTo({
                            top: hedef.getBoundingClientRect().top + window.scrollY - 40,
                            behavior: 'smooth'
                        });

                        setTimeout(function () {
                            if (input) input.focus(); // input kutusunu odakla
                        }, 450);
                    }
                } else {
                    // Başka sayfadaysa anasayfaya yönlendir
                    window.location.href = "/#kargotakip";
                }
            });
        }
    });
</script>
