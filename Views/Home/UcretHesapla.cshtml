@model KaraAmbarKargoculuk.Models.KargoUcretiViewModel
@{
    ViewData["Title"] = "Kargo Ücreti Hesapla";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4 p-4">
                <h2 class="text-center mb-4">Kargo Ücreti Hesapla</h2>

                <form asp-action="UcretHesapla" method="post">
                    <div class="form-group mb-3">
                        <label>Gönderici İl</label>
                        <select asp-for="GondericiIl" class="form-control" asp-items="@(new SelectList(Model.Iller))">
                            <option value="">İl Seçiniz</option>
                        </select>
                        <span asp-validation-for="GondericiIl" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label>Alıcı İl</label>
                        <select asp-for="AliciIl" class="form-control" asp-items="@(new SelectList(Model.Iller))">
                            <option value="">İl Seçiniz</option>
                        </select>
                        <span asp-validation-for="AliciIl" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label>Paket Ağırlığı (kg)</label>
                        <input asp-for="AgirlikKg" type="number" step="0.1" class="form-control" />
                        <span asp-validation-for="AgirlikKg" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label>Kargo Tipi</label>
                        <select asp-for="KargoTipi" class="form-control">
                            <option value="">Seçiniz</option>
                            <option>Standart</option>
                            <option>Hızlı</option>
                        </select>
                        <span asp-validation-for="KargoTipi" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Ücreti Hesapla</button>
                </form>

                @if (Model.HesaplananUcret != null)
                {
                    <div class="alert alert-success mt-4 text-center rounded-pill">
                        <strong>Toplam Ücret:</strong> @Model.HesaplananUcret TL
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
